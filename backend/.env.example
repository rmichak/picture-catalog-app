# Copy to backend/.env and fill in.
# All settings are prefixed with PCA_ (Picture Catalog App).

# --- Dropbox app ---
# Register at https://www.dropbox.com/developers/apps
# - Choose "Scoped access" + "App folder" (recommended) or "Full Dropbox"
# - Add redirect URI matching PCA_DROPBOX_REDIRECT_URI below
# - Permissions: files.metadata.read, files.content.read, account_info.read
PCA_DROPBOX_APP_KEY=
PCA_DROPBOX_APP_SECRET=
PCA_DROPBOX_REDIRECT_URI=http://localhost:8000/api/auth/dropbox/callback

# --- Server ---
PCA_HOST=0.0.0.0
PCA_PORT=8000
PCA_LOG_LEVEL=info

# --- Session signing key (any random string) ---
PCA_SESSION_SECRET=change-me-to-a-long-random-string

# --- Optional LAN access shared-secret token ---
# When set, first-time visitors must hit `/?token=<value>` to register a session cookie.
# Empty disables auth (only safe on a fully trusted LAN).
PCA_ACCESS_TOKEN=
